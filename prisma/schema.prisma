// ─────────────────────────────────────────────────────────────
//  GRC Platform – Prisma Schema
//  Single-tenant, PostgreSQL, map-once-comply-many design
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────

enum UserRole {
  ADMIN       // Full system access
  CONTRIBUTOR // Assessments & evidence
  VIEWER      // Executive reporting only
}

enum FrameworkSlug {
  NIST_CSF_2
  CIS_V8_1
  PCI_DSS_4
  ISO_27001_2022
}

enum ControlStatus {
  NOT_STARTED
  IN_PROGRESS
  IMPLEMENTED
  NOT_APPLICABLE
}

enum ControlCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskSource {
  NIST_CSF_REVIEW
  PENETRATION_TEST
  VULNERABILITY_SCAN
  SELF_IDENTIFIED
  INTERNAL_AUDIT
  EXTERNAL_AUDIT
  THIRD_PARTY
  INCIDENT
  OTHER
}

enum ReviewCadence {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum PolicyStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RETIRED
}

enum ComplianceStatus {
  COMPLIANT
  PARTIAL
  NON_COMPLIANT
  NOT_APPLICABLE
}

enum RiskLikelihood {
  RARE        // 1
  UNLIKELY    // 2
  POSSIBLE    // 3
  LIKELY      // 4
  ALMOST_CERTAIN // 5
}

enum RiskImpact {
  NEGLIGIBLE  // 1
  MINOR       // 2
  MODERATE    // 3
  MAJOR       // 4
  CRITICAL    // 5
}

enum RiskVelocity {
  SLOW        // days/weeks to materialise
  MEDIUM      // hours to days
  FAST        // immediate
}

enum RiskTreatment {
  MITIGATE
  TRANSFER
  ACCEPT
  AVOID
}

enum RemediationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

enum RemediationComplexity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvidenceType {
  PDF
  IMAGE
  CSV
  JSON
  OTHER
}

// ─── Users (Clerk-managed, we store role metadata) ────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  role      UserRole @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments  Assessment[]
  remediations Remediation[]
  evidence     Evidence[]
  auditLogs    AuditLog[]
}

// ─── Frameworks ───────────────────────────────────────────────

model Framework {
  id          String        @id @default(cuid())
  slug        FrameworkSlug @unique
  name        String        // "NIST CSF 2.0"
  version     String        // "2.0"
  description String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())

  requirements FrameworkRequirement[]
  assessments  Assessment[]
}

model FrameworkRequirement {
  id           String  @id @default(cuid())
  frameworkId  String
  controlId    String  // e.g. "GV.OC-01", "CIS-1.1"
  category     String  // e.g. "GOVERN", "Implementation Group 1"
  subCategory  String? // e.g. "Organizational Context"
  title        String
  description  String  @db.Text
  guidance     String? @db.Text
  weight       Int     @default(1) // for compliance score weighting

  framework    Framework              @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  mappings     ControlFrameworkMapping[]
  assessmentResults AssessmentResult[]

  @@index([frameworkId])
  @@index([controlId])
}

// ─── Internal Controls (the "map once" source of truth) ───────

model InternalControl {
  id               String             @id @default(cuid())
  controlCode      String             @unique // e.g. "IC-001"
  title            String
  description      String             @db.Text
  status           ControlStatus      @default(NOT_STARTED)
  criticality      ControlCriticality @default(MEDIUM)
  maturityLevel    Int                @default(0) // 0-5 CMMI-style maturity
  implementationNotes String?         @db.Text    // how the control is actually implemented
  evidenceExamples String?            @db.Text    // suggested evidence artifacts
  owner            String?            // person/team responsible
  category         String?            // e.g. "Identity & Access", "Network Security"
  tags             String[]           // free-form tags
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  frameworkMappings ControlFrameworkMapping[]
  evidence          Evidence[]
  remediations      Remediation[]
  assessmentResults AssessmentResult[]
}

// ─── Many-to-many: InternalControl ↔ FrameworkRequirement ─────

model ControlFrameworkMapping {
  id            String           @id @default(cuid())
  controlId     String
  requirementId String
  notes         String?
  createdAt     DateTime         @default(now())

  control     InternalControl      @relation(fields: [controlId], references: [id], onDelete: Cascade)
  requirement FrameworkRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([controlId, requirementId])
  @@index([controlId])
  @@index([requirementId])
}

// ─── Risk Register ────────────────────────────────────────────

model Risk {
  id               String         @id @default(cuid())
  riskId           String         @unique // e.g. "RISK-001"
  title            String
  description      String         @db.Text
  category         String?
  owner            String?
  likelihood       RiskLikelihood
  impact           RiskImpact
  velocity         RiskVelocity
  inherentScore    Int            // computed: likelihood × impact
  residualScore    Int            // after controls applied
  treatment        RiskTreatment
  treatmentDetails String?        @db.Text
  source           RiskSource     @default(SELF_IDENTIFIED)
  riskLead         String?        // person responsible for reporting/remediating
  reviewDate       DateTime?
  isOpen           Boolean        @default(true)
  // Risk exception tracking
  isException            Boolean        @default(false)
  exceptionJustification String?        @db.Text
  exceptionApprovedBy    String?
  exceptionReviewCadence ReviewCadence?
  exceptionNextReview    DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  relatedControls  String[]       // array of InternalControl.controlCode
  evidence         Evidence[]
  remediations     Remediation[]
}

// ─── Assessments ──────────────────────────────────────────────

model Assessment {
  id          String   @id @default(cuid())
  title       String
  frameworkId String
  conductedBy String   // userId
  startDate   DateTime
  endDate     DateTime?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conductor Framework        @relation(fields: [frameworkId], references: [id])
  results   AssessmentResult[]
  user      User             @relation(fields: [conductedBy], references: [id])
}

model AssessmentResult {
  id            String           @id @default(cuid())
  assessmentId  String
  controlId     String
  requirementId String
  status        ComplianceStatus
  score         Int?             // 0-100 percentage
  notes         String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  assessment  Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  control     InternalControl      @relation(fields: [controlId], references: [id])
  requirement FrameworkRequirement @relation(fields: [requirementId], references: [id])
  evidence    Evidence[]

  @@index([assessmentId])
  @@index([controlId])
}

// ─── Evidence Locker ──────────────────────────────────────────

model EvidenceFolder {
  id          String     @id @default(cuid())
  name        String     @unique // e.g. "2026 NIST CSF Review", "Pen Test 2025"
  description String?
  createdAt   DateTime   @default(now())

  evidence Evidence[]
}

model Evidence {
  id                String       @id @default(cuid())
  title             String
  description       String?
  fileName          String
  fileSize          Int          // bytes
  fileType          EvidenceType
  storageKey        String       // S3/GCS object key or local path
  uploadedBy        String       // userId
  controlId         String?
  riskId            String?
  remediationId     String?
  folderId          String?
  assessmentResultId String?
  collectedAt       DateTime     @default(now())
  expiresAt         DateTime?    // for evidence freshness tracking
  version           Int          @default(1)
  tags              String[]
  createdAt         DateTime     @default(now())

  uploader          User              @relation(fields: [uploadedBy], references: [id])
  control           InternalControl?  @relation(fields: [controlId], references: [id])
  risk              Risk?             @relation(fields: [riskId], references: [id])
  remediation       Remediation?      @relation(fields: [remediationId], references: [id])
  folder            EvidenceFolder?   @relation(fields: [folderId], references: [id])
  assessmentResult  AssessmentResult? @relation(fields: [assessmentResultId], references: [id])

  @@index([controlId])
  @@index([riskId])
  @@index([remediationId])
  @@index([folderId])
}

// ─── Remediations ─────────────────────────────────────────────

model Remediation {
  id              String                  @id @default(cuid())
  title           String
  description     String                  @db.Text
  controlId       String?                 // optional: link to a control (control OR risk required)
  riskId          String?                 // optional: link to a specific Risk
  assignedTo      String                  // userId
  status          RemediationStatus       @default(OPEN)
  priority        Int                     @default(2) // 1=Critical, 2=High, 3=Medium, 4=Low
  complexity      RemediationComplexity?  // implementation effort estimate
  dueDate         DateTime?
  resolvedAt      DateTime?
  // Jira integration
  jiraIssueKey    String?                 // e.g. "GRC-123"
  jiraIssueUrl    String?
  jiraEpicKey     String?                 // e.g. "GRC-EPIC-1"
  jiraEpicUrl     String?
  jiraSyncedAt    DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  control         InternalControl?        @relation(fields: [controlId], references: [id])
  risk            Risk?                   @relation(fields: [riskId], references: [id])
  assignee        User                    @relation(fields: [assignedTo], references: [id])
  evidence        Evidence[]

  @@index([controlId])
  @@index([riskId])
  @@index([status])
}

// ─── Policy Register ──────────────────────────────────────────

model Policy {
  id             String        @id @default(cuid())
  policyCode     String        @unique // e.g. "POL-001"
  name           String
  description    String?       @db.Text
  category       String?       // e.g. "Access Control", "Incident Response"
  owner          String?
  status         PolicyStatus  @default(DRAFT)
  version        String        @default("1.0")
  effectiveDate  DateTime?
  approvedBy     String?
  reviewCadence  ReviewCadence @default(ANNUAL)
  lastReviewedAt DateTime?
  nextReviewDate DateTime?
  // Uploaded document (metadata; storageKey mirrors Evidence pattern)
  fileName       String?
  fileSize       Int?
  storageKey     String?
  relatedControls String[]     // InternalControl.controlCode values
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  revisions PolicyRevision[]
}

model PolicyRevision {
  id        String   @id @default(cuid())
  policyId  String
  version   String   // version at the time of this revision
  summary   String   @db.Text // what changed / review outcome
  changedBy String   // user name/email
  createdAt DateTime @default(now())

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

// ─── Audit Log ────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // "CREATE_RISK", "UPDATE_CONTROL", etc.
  entityType String   // "Risk", "InternalControl", etc.
  entityId   String
  changes    Json?    // diff of what changed
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
